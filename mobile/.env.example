# Copy to `.env` for local development. `.env` is gitignored; this file is not.
#
# Both variables are EXPO_PUBLIC_*, which means Expo inlines them into the JavaScript bundle
# at build time. They are readable by anyone with the app. That is fine for the URL, and it
# is the accepted trade for the key — see the note in `src/api/client.ts`: a public client
# cannot hold a secret, and the key's job is to deter opportunistic traffic, not to resist a
# determined reader.
#
# The real key lives in Secret Manager and is set on the Cloud Run service, never committed.

# Local backend: RESFI_API_KEY=local-dev-key python -m uvicorn backend.main:app
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_KEY=local-dev-key
