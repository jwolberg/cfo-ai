# Personal agent tooling. Stripped from the repo in #3 and kept out deliberately — it is
# local workflow scaffolding, not part of the product. Ignoring it (rather than merely
# deleting it) is what stops a stale checkout, or an agent branching from a pre-strip
# commit, from quietly re-committing the whole tree.
.claude/
.codex/
.agents/
.TerMinal/
.gitlab/
CLAUDE.md
AGENTS.md
.status.md

# personal / not for the repo
private/

# Local runbooks and scratch notes. These carry real infrastructure values once filled in
# (project ids, service urls, secret names), which is the whole reason they stay local. The
# shareable version of a deploy runbook lives in docs/runbooks/ with the values stripped.
*.local.md

# python build artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Python virtualenv. The project depends on sqlalchemy/alembic/psycopg (ticket 0020) and
# the system Python may hold different versions for unrelated projects; the venv keeps them apart
# and matches what CI installs fresh via `pip install -e ".[dev]"`.
.venv/
